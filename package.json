{
  "name": "pine",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "dev": "bun run --filter @pine/desktop start",
    "build": "bun run --filter @pine/desktop make",
    "format": "bun run --filter @pine/desktop format",
    "format:check": "bun run --filter @pine/desktop format:check",
    "lint": "bun run --filter @pine/desktop lint",
    "test": "bun run --filter @pine/desktop test:run",
    "test:coverage": "bun run --filter @pine/desktop test:coverage",
    "typecheck": "bun run --filter @pine/desktop typecheck",
    "shadcn:add": "bun run apps/desktop/scripts/shadcn-add.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "latest",
    "@electron-forge/maker-deb": "latest",
    "@electron-forge/maker-rpm": "latest",
    "@electron-forge/maker-squirrel": "latest",
    "@electron-forge/maker-zip": "latest",
    "@electron-forge/plugin-vite": "latest",
    "@electron-forge/shared-types": "latest",
    "@tailwindcss/vite": "latest",
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "latest",
    "electron": "latest",
    "tailwindcss": "latest",
    "ts-node": "latest",
    "tw-animate-css": "latest",
    "typescript": "6.0.3",
    "vite": "latest",
    "vue-tsc": "3.3.6"
  }
}
